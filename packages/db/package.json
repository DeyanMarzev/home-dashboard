{
  "name": "@home/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres access shared by api and collector: migrations, source registry sync, writeReadings.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/test/database.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@home/shared": "workspace:*",
    "postgres": "^4.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18"
  }
}
