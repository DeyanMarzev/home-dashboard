# Copy to .env (git-ignored) and fill in. Never commit .env.
# Used by docker compose on the Pi and by `pnpm dev` locally.
# Comments on empty values go on their own line above: Compose reads `KEY=   # text` as the
# value "# text". `KEY=value  # text` is fine. Quote values containing $, # or spaces: 'like this'.

# --- General ---------------------------------------------------------------
NODE_ENV=production            # production on the Pi; development locally
TZ=Europe/London               # display timezone (the database always stores UTC)
DATA_DIR=/mnt/ssd/home-dashboard   # postgres/, mosquitto/, backups/ live here. No SSD yet: /opt/home-dashboard-data (docs/06 § 1.1)
LOG_LEVEL=info                 # trace | debug | info | warn | error

# --- PostgreSQL + TimescaleDB ---------------------------------------------
POSTGRES_USER=home
# long random string, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=home

# --- MQTT (Mosquitto) -----------------------------------------------------
MQTT_USERNAME=collector        # used by the collector; can read everything under home/
# e.g. `openssl rand -hex 24`
MQTT_PASSWORD=
MQTT_SENSOR_USERNAME=sensors   # used by the ESP32 room sensors; may only publish home/sensors/#
# this one gets flashed onto the sensors
MQTT_SENSOR_PASSWORD=
MQTT_NETPROBE_USERNAME=netprobe  # the netprobe container; may only publish home/net/#
# e.g. `openssl rand -hex 24`
MQTT_NETPROBE_PASSWORD=

# --- Cloudflare -----------------------------------------------------------
# Zero Trust → Networks → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=
# the <team> in <team>.cloudflareaccess.com (docs/06 §5.1)
CF_ACCESS_TEAM=
# Access application → "Application Audience (AUD) Tag" (docs/06 §5.2)
CF_ACCESS_AUD=
AUTH_DISABLED=false            # true ONLY for local development; the API refuses it in production
# (`pnpm dev` always runs the API with NODE_ENV=development and AUTH_DISABLED=true.)

# --- API, optional overrides (defaults are right for Docker) ---------------
# PORT=3000                    # never 8000 (the existing FastAPI project); the API refuses it
# PUBLIC_DIR=                  # built web app to serve; default: the copy inside the api image
# APP_VERSION=                 # shown by /api/health

# --- Location (weather + grid carbon intensity) ---------------------------
# e.g. 51.50 (2 decimals is plenty)
HOME_LAT=
# e.g. -0.12
HOME_LON=
# first half of the postcode, e.g. SW1A
HOME_POSTCODE_OUTCODE=

# --- Nest (Google Smart Device Management API) ----------------------------
# Device Access project id
NEST_PROJECT_ID=
# Google Cloud OAuth client id
NEST_CLIENT_ID=
# Google Cloud OAuth client secret
NEST_CLIENT_SECRET=
# from the one-off OAuth consent flow
NEST_REFRESH_TOKEN=

# --- Smart meters ---------------------------------------------------------
METER_PROVIDER=bright          # bright (real data) | fake (invented sample data, development only)
# the email you log in to the Bright app with
BRIGHT_USERNAME=
# the Bright app password (docs/06 § 5e)
BRIGHT_PASSWORD=

# --- Thames Water (scraped, fragile: max 3 login attempts per day) --------
WATER_PROVIDER=thames         # thames (real data) | fake (invented sample data, development only)
# your Thames Water account login (myaccount.thameswater.co.uk), docs/06 § 5f
THAMES_EMAIL=
THAMES_PASSWORD=
# optional: only if the login has several accounts or meters (default: the account's default, first meter)
THAMES_ACCOUNT_NUMBER=
THAMES_METER_ID=

# --- Boiler pipe probes (DS18B20 on 1-Wire; leave empty until fitted) -----
# e.g. 28-0123456789ab (see `ls /sys/bus/w1/devices/`)
BOILER_FLOW_W1_ID=
BOILER_RETURN_W1_ID=

# --- Network (netprobe container, M9) -------------------------------------
WIFI_INTERFACE=wlan0           # the Pi's Wi-Fi interface (Wi-Fi readings are skipped on Ethernet)
PING_TARGET=1.1.1.1            # "internet" latency target
# e.g. http://192.168.1.1 (default: the network's gateway)
ROUTER_URL=
# Linksys MX4200 admin password: device counts via its local JNAP API.
# Leave empty to count devices with an ARP scan instead.
ROUTER_PASSWORD=

# --- Backups --------------------------------------------------------------
# Nightly scripts/backup.sh keeps 7 dumps in $DATA_DIR/backups; with a remote set it also copies
# each one there (kept 30 days). Setup: docs/06 § 8.1. Empty = backups stay on the Pi only.
# rclone remote:folder, e.g. gdrive:home-dashboard-backups
BACKUP_RCLONE_REMOTE=

# --- Local development only (ignored on the Pi) ---------------------------
# Start Postgres + Mosquitto locally:  docker compose -f docker-compose.dev.yml up -d
# Then uncomment these so `pnpm dev` can reach them (values match POSTGRES_* above):
# PGHOST=127.0.0.1
# PGPORT=5433
# PGUSER=home
# PGPASSWORD=
# PGDATABASE=home
# Database tests always run on PGlite (Postgres in WebAssembly, Timescale stubbed). To also
# run them against real TimescaleDB, pass this on the command line (not read from .env):
#   TEST_DATABASE_URL=postgres://home:<password>@127.0.0.1:5433/postgres pnpm --filter @home/db test
# A throwaway database is created and dropped for each run.
# Database connections per process (default: api 10, collector 4). Set 1 when running
# against PGlite: it shares one session between connections, so parallel prepared
# statements collide.
# DB_POOL_MAX=
# MQTT broker for `pnpm dev` and `pnpm fake-sensor` (Docker sets mqtt://mosquitto:1883):
# MQTT_URL=mqtt://localhost:1883
# How often `pnpm fake-sensor` publishes (default 30):
# FAKE_SENSOR_INTERVAL_SECONDS=30
# Host paths for pi_stats (Docker sets these to the read-only mounts; defaults /sys, /proc, /):
# HOST_SYS=/sys
# HOST_PROC=/proc
# HOST_ROOTFS=/
# HOST_DATA_DIR=
# Web app build only: API base URL. Empty = same origin (the API serves the web app).
# The Android app (M11) sets it to https://home.deyan.uk.
# VITE_API_BASE=
# Paths used at startup (defaults are right for Docker; `pnpm dev` sets them):
# MIGRATIONS_DIR=db/migrations
# SOURCES_FILE=config/sources.yaml
