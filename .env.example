# Copy to .env (git-ignored) and fill in. Never commit .env.
# Used by docker compose on the Pi and by `pnpm dev` locally.

# --- General ---------------------------------------------------------------
NODE_ENV=production            # production on the Pi; development locally
TZ=Europe/London               # display timezone (the database always stores UTC)
DATA_DIR=/mnt/ssd/home-dashboard   # postgres/, mosquitto/, backups/ live under here (on the SSD)
LOG_LEVEL=info                 # trace | debug | info | warn | error

# --- PostgreSQL + TimescaleDB ---------------------------------------------
POSTGRES_USER=home
POSTGRES_PASSWORD=             # long random string, e.g. `openssl rand -hex 24`
POSTGRES_DB=home

# --- MQTT (Mosquitto) -----------------------------------------------------
MQTT_USERNAME=collector        # used by the collector; can read everything under home/
MQTT_PASSWORD=                 # e.g. `openssl rand -hex 24`
MQTT_SENSOR_USERNAME=sensors   # used by the ESP32 room sensors; may only publish home/sensors/#
MQTT_SENSOR_PASSWORD=          # this one gets flashed onto the sensors

# --- Cloudflare -----------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=       # Zero Trust → Networks → Tunnels → your tunnel → token
CF_ACCESS_TEAM=                # the <team> in <team>.cloudflareaccess.com (docs/06 §5.1)
CF_ACCESS_AUD=                 # Access application → "Application Audience (AUD) Tag" (docs/06 §5.2)
AUTH_DISABLED=false            # true ONLY for local development; the API refuses it in production
# (`pnpm dev` always runs the API with NODE_ENV=development and AUTH_DISABLED=true.)

# --- API, optional overrides (defaults are right for Docker) ---------------
# PORT=3000                    # never 8000 (the existing FastAPI project); the API refuses it
# PUBLIC_DIR=                  # built web app to serve; default: the copy inside the api image
# APP_VERSION=                 # shown by /api/health

# --- Location (weather + grid carbon intensity) ---------------------------
HOME_LAT=                      # e.g. 51.50 (2 decimals is plenty)
HOME_LON=                      # e.g. -0.12
HOME_POSTCODE_OUTCODE=         # first half of the postcode, e.g. SW1A

# --- Nest (Google Smart Device Management API) ----------------------------
NEST_PROJECT_ID=               # Device Access project id
NEST_CLIENT_ID=                # Google Cloud OAuth client id
NEST_CLIENT_SECRET=            # Google Cloud OAuth client secret
NEST_REFRESH_TOKEN=            # from the one-off OAuth consent flow

# --- Smart meters ---------------------------------------------------------
METER_PROVIDER=fake            # fake | <provider chosen later, see docs/08-open-questions.md>
# provider-specific variables are added here once the provider is chosen

# --- Thames Water (scraped, fragile: max 3 login attempts per day) --------
THAMES_EMAIL=
THAMES_PASSWORD=
THAMES_ACCOUNT_NUMBER=
THAMES_METER_ID=

# --- Boiler pipe probes (DS18B20 on 1-Wire; leave empty until fitted) -----
BOILER_FLOW_W1_ID=             # e.g. 28-0123456789ab (see `ls /sys/bus/w1/devices/`)
BOILER_RETURN_W1_ID=

# --- Backups --------------------------------------------------------------
BACKUP_RCLONE_REMOTE=          # optional rclone target, e.g. gdrive:home-dashboard-backups

# --- Local development only (ignored on the Pi) ---------------------------
# Start Postgres + Mosquitto locally:  docker compose -f docker-compose.dev.yml up -d
# Then uncomment these so `pnpm dev` can reach them (values match POSTGRES_* above):
# PGHOST=127.0.0.1
# PGPORT=5433
# PGUSER=home
# PGPASSWORD=
# PGDATABASE=home
# Database tests always run on PGlite (Postgres in WebAssembly, Timescale stubbed). To also
# run them against real TimescaleDB, pass this on the command line (not read from .env):
#   TEST_DATABASE_URL=postgres://home:<password>@127.0.0.1:5433/postgres pnpm --filter @home/db test
# A throwaway database is created and dropped for each run.
# Paths used at startup (defaults are right for Docker; `pnpm dev` sets them):
# MIGRATIONS_DIR=db/migrations
# SOURCES_FILE=config/sources.yaml
