{
  "name": "@home/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "NODE_ENV=development AUTH_DISABLED=true MIGRATIONS_DIR=../../db/migrations SOURCES_FILE=../../config/sources.yaml tsx watch --env-file-if-exists=../../.env --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/static": "^10.1.10",
    "@home/db": "workspace:*",
    "@home/shared": "workspace:*",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
