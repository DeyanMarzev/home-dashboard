{
  "name": "@home/collector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "NODE_ENV=development MIGRATIONS_DIR=../../db/migrations SOURCES_FILE=../../config/sources.yaml tsx watch --env-file-if-exists=../../.env --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "fake-sensor": "tsx --env-file-if-exists=../../.env --conditions=development src/tools/fake-sensor.ts"
  },
  "dependencies": {
    "@home/db": "workspace:*",
    "@home/shared": "workspace:*",
    "croner": "^11.0.0",
    "mqtt": "^5.16.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
